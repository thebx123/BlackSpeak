
/*
 * TeamSpeak 3 Modern Black Qt StyleSheet
 * Designed by Coretify Studio
 *
 * Global overrides for QPalette::ColorRole values:
 * QPalette::Window = #060709;
 * QPalette::WindowText = #FFFFFF;
 * QPalette::Base = #060709;
 * QPalette::AlternateBase = #0A0C10;
 * QPalette::Text = #FFFFFF;
 * QPalette::Button = #0F1117;
 * QPalette::ButtonText = #FFFFFF;
 * QPalette::Highlight = #2563EB;
 * QPalette::HighlightedText = #FFFFFF;
 * QPalette::ToolTipBase = #0A0C10;
 * QPalette::ToolTipText = #FFFFFF;
 * QPalette::Link = #3B82F6;
 * QPalette::Dark = #060709;
 * QPalette::Mid = #141720;
 * QPalette::Midlight = #1E222D;
 * QPalette::Light = #2A303F;
 * QPalette::Shadow = #000000;
 *
 * Global overrides for specific highlight colors:
 * CustomColor::ClientFriend    = #2ECC71;
 * CustomColor::ClientBlocked   = #E74C3C;
 * CustomColor::ClientRecording = #E74C3C;
 */

/* --- 1. Global Window & Base Settings --- */
QWidget {
    background-color: #060709;
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 9pt;
    border: none;
    outline: none;
}

QWidget:disabled {
    color: #555A64;
}

QMainWindow, QDialog {
    background-color: #060709;
    color: #FFFFFF;
}

/* --- 2. Top MenuBar (نوار زیر تایتل‌بار با خط تفکیک مدرن و درخشان) --- */
QMenuBar {
    background-color: #060709;
    color: #9AA0A6;
    border: none;
    border-bottom: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.12 #141720,
        stop:0.30 #1E222D,
        stop:0.42 #2563EB,
        stop:0.50 #60A5FA,
        stop:0.58 #2563EB,
        stop:0.70 #1E222D,
        stop:0.88 #141720,
        stop:1 transparent);
    padding: 3px 6px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #12151B;
    color: #FFFFFF;
}

QMenuBar::item:pressed {
    background-color: #1A1E26;
    color: #FFFFFF;
}

/* --- 3. ToolBar & Tool Buttons (فاصله‌بندی استاندارد و اصلاح فلش منو) --- */
QToolBar {
    background-color: #060709;
    border: none;
    border-bottom: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.15 #141720,
        stop:0.35 #1E222D,
        stop:0.50 #2563EB,
        stop:0.65 #1E222D,
        stop:0.85 #141720,
        stop:1 transparent);
    padding: 4px 6px;
    spacing: 6px;
}

QToolBar::handle {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QToolButton {
    background-color: #0F1117;
    color: #FFFFFF;
    border: 1px solid #1E222D;
    border-radius: 4px;
    padding: 4px 6px;
    margin: 1px 2px;
    min-width: 24px;
    min-height: 24px;
}

/* فاصله بازتر برای دکمه‌های دارای فلش منوی کشویی */
QToolButton[popupMode="1"] {
    padding-right: 18px;
}

QToolButton[popupMode="2"] {
    padding-right: 14px;
}

QToolButton::menu-button {
    border: none;
    border-left: 1px solid #1E222D;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    width: 14px;
    background-color: transparent;
}

QToolButton::menu-button:hover {
    background-color: #1A1E26;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    top: 0px;
    width: 8px;
    height: 6px;
}

QToolButton:hover {
    background-color: #1A1E26;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #252B3B;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}

QToolBar::separator {
    width: 1px;
    background-color: #1E222D;
    margin: 4px 6px;
}

/* --- 4. Main Panels: Channel Tree, Info Frame, Chat Log --- */
QTreeView, QListView, QTableView, QListWidget, QTreeWidget {
    background-color: #0A0C10;
    color: #FFFFFF;
    border: 1px solid #141720;
    border-radius: 4px;
    padding: 1px;
    outline: none;
}

QTreeView::item, QListView::item, QListWidget::item {
    padding: 2px 4px;
    border-radius: 3px;
    color: #E0E0E0;
    outline: none;
}

QTreeView::item:hover, QListView::item:hover, QListWidget::item:hover {
    background-color: #12151B;
    color: #FFFFFF;
}

QTreeView::item:selected, QListView::item:selected, QListWidget::item:selected {
    background-color: #1A1E26;
    color: #60A5FA;
    border: 1px solid #3B82F6;
}

QTreeView::branch {
    background-color: transparent;
}

/* --- 5. Text Inputs, Chat Log and Info Frame --- */
QTextEdit, QTextBrowser, QPlainTextEdit, QLineEdit {
    background-color: #0A0C10;
    color: #FFFFFF;
    border: 1px solid #1E222D;
    border-radius: 4px;
    padding: 4px 8px;
    outline: none;
    selection-background-color: #1A1E26;
    selection-color: #60A5FA;
}

QTextEdit:focus, QTextBrowser:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #0F1117;
    outline: none;
}

QTextEdit#ChatTab, QTextEdit#InfoFrame {
    background-color: #060709;
    border: 1px solid #141720;
    border-radius: 4px;
    padding: 4px 8px 4px 4px;
    outline: none;
}

/* --- 6. Splitters & Resize Bars --- */
QSplitter {
    background-color: #060709;
}

QSplitter::handle {
    background-color: #060709;
}

QSplitter::handle:horizontal {
    width: 4px;
    background-color: #060709;
}

QSplitter::handle:vertical {
    height: 4px;
    background-color: #060709;
}

QSplitter::handle:hover {
    background-color: #3B82F6;
}

QMainWindow::separator {
    background-color: #060709;
    width: 4px;
    height: 4px;
}

QMainWindow::separator:hover {
    background-color: #3B82F6;
}

/* --- 7. Tabs --- */
QTabWidget::pane {
    border: 1px solid #141720;
    background-color: #060709;
    top: 0px;
    border-radius: 0 0 4px 4px;
}

QTabBar {
    background-color: #060709;
    qproperty-drawBase: 0;
    border: none;
    margin: 0px;
}

QTabBar::tab {
    background-color: #0A0C10;
    color: #8A8F9D;
    padding: 6px 14px;
    border: 1px solid #141720;
    border-bottom: 2px solid transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    outline: none;
}

QTabBar::tab:hover {
    color: #FFFFFF;
    background-color: #12151B;
    border-color: #1E222D;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    background-color: #060709;
    border: 1px solid #1E222D;
    border-bottom: 2px solid #3B82F6;
    font-weight: bold;
}

/* دکمه ضربدر بستن تب */
QTabBar::close-button {
    background: transparent;
    border: none;
    border-radius: 2px;
    padding: 2px;
    margin: 1px;
}

QTabBar::close-button:hover {
    background-color: #E74C3C;
}

QTabBar::close-button:pressed {
    background-color: #C0392B;
}

/* --- 8. ScrollBars (اسکرول‌بار باریک، مدرن و کپسولی کاملاً گرد Slim Rounded Pill) --- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #2563EB;
    min-height: 20px;
    border-radius: 3px;
    border: none;
}

QScrollBar::handle:vertical:hover {
    background-color: #3B82F6;
}

QScrollBar::handle:vertical:pressed {
    background-color: #60A5FA;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #2563EB;
    min-width: 20px;
    border-radius: 3px;
    border: none;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3B82F6;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #60A5FA;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
}

/* --- 9. Push Buttons --- */
QPushButton {
    background-color: #0F1117;
    color: #FFFFFF;
    border: 1px solid #1E222D;
    border-radius: 4px;
    padding: 5px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1A1E26;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #060709;
    border: 1px solid #141720;
}

QPushButton:disabled {
    background-color: #060709;
    color: #555A64;
    border: 1px solid #141720;
}

/* --- 10. Menus --- */
QMenu {
    background-color: #0A0C10;
    color: #FFFFFF;
    border: 1px solid #1E222D;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 16px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #161A22;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #1E222D;
    margin: 4px 2px;
}

/* --- 11. ComboBox --- */
QComboBox {
    background-color: #0F1117;
    color: #FFFFFF;
    border: 1px solid #1E222D;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox:hover {
    border: 1px solid #3B82F6;
    background-color: #12151B;
}

QComboBox QAbstractItemView {
    background-color: #0A0C10;
    color: #FFFFFF;
    border: 1px solid #1E222D;
    selection-background-color: #1A1E26;
    selection-color: #FFFFFF;
}

/* --- 12. CheckBox & RadioButton --- */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    spacing: 6px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #0F1117;
    border: 1px solid #1E222D;
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #3B82F6;
    background-color: #12151B;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3B82F6;
    border: 1px solid #3B82F6;
}

/* --- 13. GroupBox & Table Header --- */
QGroupBox {
    border: 1px solid #1E222D;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: transparent;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #A0A0A0;
}

QHeaderView::section {
    background-color: #0A0C10;
    color: #A0A0A0;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid #141720;
    border-bottom: 1px solid #141720;
    font-weight: 500;
}

/* --- 14. ToolTip & StatusBar --- */
QToolTip {
    background-color: #0A0C10;
    color: #FFFFFF;
    border: 1px solid #2A303F;
    border-radius: 4px;
    padding: 4px 8px;
}

QStatusBar {
    background-color: #060709;
    color: #64748B;
    border-top: 1px solid #141720;
}

QStatusBar QLabel {
    color: #64748B;
    padding: 0px 4px;
}

/* --- 15. Tools > Options & Dialog Headlines --- */
QWidget#HeadlineLabel {
    background-color: #0A0C10;
    border-bottom: 1px solid #1E222D;
}

QLabel#OptionsHeadlineTitleLabel {
    font: 16px 'Segoe UI';
    color: #FFFFFF;
    font-weight: bold;
}

QLabel#OptionsHeadlineDescriptionLabel {
    color: #8A8F9D;
    font-size: 9pt;
}

QLabel#bookmarksBanner, QLabel#identitiesBanner, QLabel#accountLoginBanner, QLabel#accountCreateBanner {
    background-color: #0A0C10;
    color: #FFFFFF;
    border-bottom: 1px solid #1E222D;
    padding: 6px 10px;
    font-weight: bold;
}

/* --- 16. Host Message Popup Dialog --- */
QDialog#HostMessageDialog, QDialog[windowTitle="Host Message"], QDialog[windowTitle="Hostmessage"] {
    background-color: #0A0C10;
    min-width: 520px;
    min-height: 280px;
}

