/* ==========================================================================
   Modern Black Chat Theme for TeamSpeak 3
   Designed by Coretify Studio
   ========================================================================== */

/* @group Global Elements */
p {
    padding: 0px;
    margin: 0px;
}

ChatTab {
    background-color: #060709;
    color: #FFFFFF;
}

/* @end */

/* @group Object Link Elements (Consistent borders and highlights) */
a {
    text-decoration: none;
    outline: none;
}

a:hover {
    text-decoration: underline;
}

.TextMessage_UserLink {
    color: #5E9FD8;
    font-weight: bold;
    text-decoration: none;
    outline: none;
}

.TextMessage_UserLink:focus, .TextMessage_UserLink:active {
    background-color: #1A1E26;
    border: 1px solid #3B82F6;
    border-radius: 3px;
    outline: none;
}

.TextMessage_OfflineLink {
    color: #707580;
    font-weight: bold;
    text-decoration: none;
    outline: none;
}

.TextMessage_ChannelLink {
    color: #2ECC71;
    font-weight: bold;
    text-decoration: none;
    outline: none;
}

.TextMessage_ChannelLink:focus, .TextMessage_ChannelLink:active {
    background-color: #1A1E26;
    border: 1px solid #3B82F6;
    border-radius: 3px;
    outline: none;
}

.TextMessage_ServerLink {
    color: #E8A838;
    font-weight: bold;
    text-decoration: none;
    outline: none;
}

.TextMessage_ServerLink:focus, .TextMessage_ServerLink:active {
    background-color: #1A1E26;
    border: 1px solid #3B82F6;
    border-radius: 3px;
    outline: none;
}

/* @end */

/* @group Colored Message Elements & Private Messages */
.TextMessage_HostName {
    color: #5E9FD8;
    font-weight: bold;
}

.TextMessage_Welcome,
.TextMessage_HostMessage,
.TextMessage_Poke {
    color: #2ECC71;
}

.TextMessage_Normal,
.TextMessage_Connected,
.TextMessage_ClientConnected,
.TextMessage_ClientJoined {
    color: #9AA0A6;
}

.TextMessage_Disconnected,
.TextMessage_ClientDisconnected,
.TextMessage_ClientSwitched,
.TextMessage_ClientLeft {
    color: #707580;
}

.TextMessage_ClientDropped,
.TextMessage_ClientKicked,
.TextMessage_ClientBanned {
    color: #E74C3C;
    font-weight: bold;
}

.TextMessage_ChannelCreated,
.TextMessage_ChannelDeleted,
.TextMessage_ChannelEdited,
.TextMessage_ChannelMoved,
.TextMessage_ServerEdited {
    color: #9AA0A6;
}

.TextMessage_GroupAssigned,
.TextMessage_GroupRevoked,
.TextMessage_TalkPowerAssigned,
.TextMessage_TalkPowerRevoked,
.TextMessage_TalkPowerRequested {
    color: #5E9FD8;
}

/* Private Messages */
.TextMessage_Message.Private {
    color: #60A5FA;
    font-weight: bold;
}

.TextMessage_Message.Incoming {
    color: #E0E0E0;
}

.TextMessage_Message.Outgoing {
    color: #A0A0A0;
}

.TextMessage_Message.Friend {
    color: #2ECC71;
}

.TextMessage_Message.Blocked {
    color: #E74C3C;
}

/* @end */

/* @group Time and History Elements */
.TextMessage_Time {
    color: #707580;
    font-weight: normal;
}

.TextMessage_BeginHistory,
.TextMessage_EndHistory {
    color: #2A303F;
    font-weight: bold;
    font-style: italic;
}

/* @end */

/* @group Error Message Elements */
.TextMessage_ServerError {
    color: #E74C3C;
    font-weight: bold;
}

/* @end */
